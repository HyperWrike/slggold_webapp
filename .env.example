# ==========================================================================
# SLG Golds — Environment Variables
# ==========================================================================
# Copy to `.env.local` for local dev. Never commit real secrets.
#
# TWO deployment surfaces:
#   1. Vercel  (frontend / Expo web build)  -> only EXPO_PUBLIC_* vars
#   2. Convex  (backend functions)          -> all the server-side secrets
# --------------------------------------------------------------------------

# --- Frontend (set in Vercel Project → Settings → Environment Variables) ---
# Convex deployment URL the web client talks to.
EXPO_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# --- Backend (set with: npx convex env set <NAME> <value> --prod) ----------
# 32-byte AES-256-GCM key as 64 hex chars. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AADHAAR_ENCRYPTION_KEY=

# Razorpay live/test keys. If unset or contain "placeholder", payments run
# in mock mode (no real charges) — DO NOT ship to prod without real keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Brevo (Sendinblue) transactional email for OTP / notifications.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@slggolds.com
BREVO_SENDER_NAME=SLG Golds
