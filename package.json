    "expo-constants": "~57.0.3",
    "expo-crypto": "^57.0.0",
    "expo-device": "~57.0.0",
    "expo-font": "~57.0.0",
    "expo-glass-effect": "~57.0.0",
    "expo-image": "~57.0.0",
    "expo-linking": "~57.0.2",
    "expo-local-authentication": "^57.0.0",
